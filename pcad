    // --- MÓDULO TEÓRICO (DIFÍCIL / EXPERTO) ---
    function iniciarJuegoTeorico(nivel) {
        sonido.click();
        appState.modo = nivel;
        const base = (nivel === 'dificil') ? PREGUNTAS_DIFICIL : PREGUNTAS_EXPERTO;
        appState.banco = [...base].sort(() => 0.5 - Math.random());
        appState.indice = 0;
        appState.puntos = 0;
        appState.racha = 0;
        appState.maxRacha = 0;
        appState.tiempoInicio = Date.now();

        cambiarPantalla('juego-screen');
        cargarPregunta();
    }

    function cargarPregunta() {
        appState.respondida = false;
        const p = appState.banco[appState.indice];

        document.getElementById('materia-txt').innerText = p.materia;
        document.getElementById('categoria-badge').innerText = `MÓDULO: ${appState.modo.toUpperCase()} • ${p.materia.toUpperCase()}`;
        document.getElementById('progreso-txt').innerText = `${appState.indice + 1}/${appState.banco.length}`;
        document.getElementById('puntos-txt').innerText = appState.puntos;
        document.getElementById('racha-txt').innerText = appState.racha;
        document.getElementById('pregunta-container-txt').innerText = p.pregunta;

        const cont = document.getElementById('opciones-container');
        cont.innerHTML = '';

        const letras = ['A', 'B', 'C', 'D'];
        p.opciones.forEach((opc, idx) => {
            const btn = document.createElement('div');
            btn.className = 'opcion';
            btn.innerHTML = `<div class="letra">${letras[idx]}</div><div>${opc}</div>`;
            btn.onclick = () => seleccionarOpcion(idx, btn);
            cont.appendChild(btn);
        });

        const feedback = document.getElementById('feedback-container');
        feedback.className = 'feedback-box';
        feedback.innerHTML = '';

        document.getElementById('btn-siguiente').disabled = true;
        iniciarTimerPregunta();
    }

    function iniciarTimerPregunta() {
        detenerTimer();
        appState.tiempoRestante = 30;
        const wrap = document.getElementById('timer-bar-wrap');
        const bar = document.getElementById('timer-bar');
        wrap.style.display = 'block';
        bar.style.width = '100%';
        bar.style.backgroundColor = 'var(--verde)';

        appState.timerId = setInterval(() => {
            appState.tiempoRestante -= 0.1;
            const pct = Math.max(0, (appState.tiempoRestante / 30) * 100);
            bar.style.width = `${pct}%`;

            if (pct < 30) {
                bar.style.backgroundColor = 'var(--rojo)';
            } else if (pct < 60) {
                bar.style.backgroundColor = 'var(--amarillo)';
            }

            if (appState.tiempoRestante <= 0) {
                detenerTimer();
                tiempoAgotado();
            }
        }, 100);
    }

    function detenerTimer() {
        if (appState.timerId) {
            clearInterval(appState.timerId);
            appState.timerId = null;
        }
        const wrap = document.getElementById('timer-bar-wrap');
        if (wrap) wrap.style.display = 'none';
    }

    function tiempoAgotado() {
        if (appState.respondida) return;
        sonido.error();
        const p = appState.banco[appState.indice];
        const opcionesDOM = document.getElementById('opciones-container').children;
        bloquearOpciones();

        appState.racha = 0;
        document.getElementById('racha-txt').innerText = '0';

        opcionesDOM[p.correcta].classList.add('correcta');
        const feedback = document.getElementById('feedback-container');
        feedback.className = 'feedback-box show fail';
        feedback.innerHTML = `<strong>⏰ ¡TIEMPO AGOTADO!</strong><div class="justificacion">${p.justificacion}</div>`;
        document.getElementById('btn-siguiente').disabled = false;
    }

    function bloquearOpciones() {
        appState.respondida = true;
        detenerTimer();
        const opciones = document.querySelectorAll('.opcion');
        opciones.forEach(o => o.classList.add('bloqueada'));
    }

    function seleccionarOpcion(idx, btnElem) {
        if (appState.respondida) return;
        bloquearOpciones();

        const p = appState.banco[appState.indice];
        const opcionesDOM = document.getElementById('opciones-container').children;
        const feedback = document.getElementById('feedback-container');

        if (idx === p.correcta) {
            sonido.acierto();
            btnElem.classList.add('correcta');

            appState.racha++;
            if (appState.racha > appState.maxRacha) appState.maxRacha = appState.racha;

            // Multiplicador por racha y velocidad
            const bonusVelocidad = Math.round(appState.tiempoRestante * 0.5);
            const multiRacha = appState.racha >= 3 ? 1.5 : 1;
            const ptsGanados = Math.round((10 + bonusVelocidad) * multiRacha);
            appState.puntos += ptsGanados;

            feedback.className = 'feedback-box show ok';
            feedback.innerHTML = `<strong>✅ ¡RESPUESTA TÁCTICAMENTE CORRECTA! (+${ptsGanados} pts)</strong><div class="justificacion">${p.justificacion}</div>`;
        } else {
            sonido.error();
            btnElem.classList.add('incorrecta');
            opcionesDOM[p.correcta].classList.add('correcta');

            appState.racha = 0;
            feedback.className = 'feedback-box show fail';
            feedback.innerHTML = `<strong>❌ RESPUESTA NO PROCEDENTE</strong><div class="justificacion">Opción correcta: Letra ${['A','B','C','D'][p.correcta]}.<br>${p.justificacion}</div>`;
        }

        document.getElementById('puntos-txt').innerText = appState.puntos;
        document.getElementById('racha-txt').innerText = appState.racha;
        document.getElementById('btn-siguiente').disabled = false;
    }

    function siguientePregunta() {
        sonido.click();
        appState.indice++;
        if (appState.indice < appState.banco.length) {
            cargarPregunta();
