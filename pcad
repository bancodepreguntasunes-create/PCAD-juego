<script>
    /* =======================================================
       SINTETIZADOR DE AUDIO WEB (EFECTOS DE SONIDO SINESTÉSICOS)
       ======================================================= */
    class AudioTactico {
        constructor() {
            this.ctx = null;
            this.silencio = false;
        }
        init() {
            if (!this.ctx) {
                const AudioCtx = window.AudioContext || window.webkitAudioContext;
                if (AudioCtx) this.ctx = new AudioCtx();
            }
            if (this.ctx && this.ctx.state === 'suspended') {
                this.ctx.resume();
            }
        }
        beep(freq = 440, type = 'sine', duration = 0.08, vol = 0.15) {
            if (this.silencio) return;
            try {
                this.init();
                if (!this.ctx) return;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = type;
                osc.frequency.setValueAtTime(freq, this.ctx.currentTime);
                gain.gain.setValueAtTime(vol, this.ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + duration);
                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start();
                osc.stop(this.ctx.currentTime + duration);
            } catch(e) {}
        }
        acierto() {
            if (this.silencio) return;
            this.beep(523.25, 'triangle', 0.1, 0.2); // C5
            setTimeout(() => this.beep(659.25, 'triangle', 0.12, 0.25), 90); // E5
            setTimeout(() => this.beep(783.99, 'sine', 0.2, 0.25), 180); // G5
        }
        error() {
            if (this.silencio) return;
            this.beep(220, 'sawtooth', 0.15, 0.2);
            setTimeout(() => this.beep(164.81, 'sawtooth', 0.25, 0.22), 120);
        }
        click() {
            this.beep(800, 'sine', 0.03, 0.08);
        }
        rogerBip() {
            if (this.silencio) return;
            this.beep(1200, 'sine', 0.04, 0.15);
            setTimeout(() => this.beep(1800, 'sine', 0.06, 0.18), 50);
        }
        fanfarria() {
            if (this.silencio) return;
