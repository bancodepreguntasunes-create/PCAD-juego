    function enviarMensajeChat() {
        const input = document.getElementById('chat-input');
        const raw = input.value.trim();
        if (!raw) return;

        agregarMensajeChat(raw, 'msg-user');
        input.value = "";
        sonido.rogerBip();

        const q = raw.toLowerCase();
        let r = "No dispongo de una directriz exacta para ese término. Intenta con: 'SAR', 'grietas', 'esqueleto', 'NFPA', 'SIG', 'RADAR', 'LOPCYMAT' o 'sismo'.";

        if (q.includes('sar') || q.includes('incerfa') || q.includes('alerfa') || q.includes('destrefa') || q.includes('rescate')) {
            r = "🚨 DOCTRINA SAR: Recuerda las 3 fases reglamentarias:\n1. INCERFA = Incertidumbre (retraso no justificado).\n2. ALERFA = Alerta (aprensión fundada por la nave).\n3. DESTREFA = Desastre/Siniestro inminente confirmado. ¡Memorízalas en ese orden!";
        } else if (q.includes('grieta') || q.includes('estructura') || q.includes('esqueleto') || q.includes('piel') || q.includes('columna')) {
            r = "🏗️ REGLA DE ORO DE ESTRUCTURAS:\n• El Esqueleto (columnas, vigas, nodos): grietas a 45° o cabillas expuestas significan EVACUACIÓN INMEDIATA.\n• La Piel (paredes de tabiquería): grietas en 'X' en ladrillos absorben sismo sin colapso inminente si las columnas están sanas.";
        } else if (q.includes('nfpa') || q.includes('rombo') || q.includes('quimico') || q.includes('material')) {
            r = "🧪 ROMBO NFPA 704:\n• Azul: Salud humana (0 normal a 4 mortal).\n• Rojo: Inflamabilidad (fuego).\n• Amarillo: Inestabilidad / reactividad.\n• Blanco: Riesgos especiales (W: no usar agua).";
        } else if (q.includes('sig') || q.includes('mde') || q.includes('radar') || q.includes('sensor')) {
            r = "🛰️ TECNOLOGÍA EN GESTIÓN DE RIESGO:\n• Sensor RADAR: Mide crecidas de ríos sin contacto físico (el lodo no lo rompe).\n• MDE (Modelo Digital Elevaciones): Analiza pendientes y cauces de inundación.\n• Banda NIR: Refleja biomasa vegetal sana.";
        } else if (q.includes('lopcymat') || q.includes('incidente') || q.includes('accidente')) {
            r = "⚖️ LOPCYMAT:\nUn 'incidente' es un suceso imprevisto que no produjo lesiones ni daños materiales pero sirve de advertencia preventiva obligatoria.";
        } else if (q.includes('sismo') || q.includes('terremoto')) {
            r = "⚠️ POST-SISMO PASO 1:\nAntes de inspeccionar paredes, descarta riesgos vitales: corta de inmediato electricidad y gas doméstico para impedir explosiones secundarias.";
        }

        setTimeout(() => {
            agregarMensajeChat(r, 'msg-bot');
        }, 450);
