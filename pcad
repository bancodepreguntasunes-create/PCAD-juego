    // --- PANTALLA FINAL Y EVALUACIÓN SEGÚN ESCALA UNES (0 A 20 PTS) ---
    function mostrarResultadosFinales(tipo) {
        sonido.fanfarria();
        detenerTimer();
        cambiarPantalla('resultado-screen');

        let nota20 = 0;
        let efectividad = 0;
        let totalPuntos = 0;

        if (tipo === 'teorico') {
            const correctas = Math.round(appState.puntos / 10);
            nota20 = Math.min(20, Math.round((appState.puntos / (appState.banco.length * 15)) * 20));
            if (appState.puntos > 80 && nota20 < 16) nota20 = 16;
            efectividad = Math.min(100, Math.round((appState.puntos / (appState.banco.length * 12)) * 100));
            totalPuntos = appState.puntos;
        } else if (tipo === 'estructuras') {
            const total = appState.escenariosEst.length;
            nota20 = Math.round((appState.aciertosEst / total) * 20);
            efectividad = Math.round((appState.aciertosEst / total) * 100);
            totalPuntos = appState.aciertosEst * 20;
        } else if (tipo === 'despacho') {
            const total = ESCENARIOS_DESPACHO.length;
            nota20 = Math.round((appState.puntosDespacho / (total * 25)) * 20);
            efectividad = Math.round((appState.puntosDespacho / (total * 25)) * 100);
            totalPuntos = appState.puntosDespacho;
        }

        const tiempoTotal = Math.round((Date.now() - appState.tiempoInicio) / 1000);

        let califTexto = "INSUFICIENTE";
        let mensaje = "Necesitas repasar a fondo los manuales operacionales de Protección Civil y los protocolos SAR.";
        let rango = "Aspirante";
        let emblema = "📋";

        if (nota20 >= 19) {
            califTexto = "EXCELENTE (MENCIÓN HONORÍFICA)";
            mensaje = "¡Rendimiento táctico insuperable! Demuestras solvencia operativa integral como Comisionado PCAD.";
            rango = "Comisionado de Operaciones";
            emblema = "⭐";
        } else if (nota20 >= 16) {
            califTexto = "SOBRESALIENTE";
            mensaje = "Excelente dominio técnico de la doctrina UNES. Apto para liderar comisiones en terreno.";
            rango = "Inspector PCAD";
            emblema = "🎖️";
        } else if (nota20 >= 13) {
            califTexto = "BUENO (APROBADO)";
            mensaje = "Cumples con el perfil de TSU en Operaciones de Protección Civil. Refuerza temas específicos.";
            rango = "Oficial de Operaciones";
            emblema = "🛡️";
        } else if (nota20 >= 10) {
            califTexto = "REGULAR (APROBADO MÍNIMO)";
            mensaje = "Aprobado con observaciones. Se sugiere estudiar el glosario táctico y el manual de estructuras.";
            rango = "Discente TSU";
            emblema = "⚠️";
        }

        document.getElementById('res-icono').innerText = emblema;
        document.getElementById('res-nota').innerText = nota20;
        document.getElementById('res-calificacion').innerText = califTexto;
        document.getElementById('res-mensaje').innerText = mensaje;
        document.getElementById('res-puntos').innerText = totalPuntos;
        document.getElementById('res-efectividad').innerText = `${efectividad}%`;
        document.getElementById('res-tiempo').innerText = `${tiempoTotal}s`;

        // Guardar récord si supera el previo
        const recordPrevio = parseInt(localStorage.getItem('pcad_record') || '0', 10);
        if (totalPuntos > recordPrevio) {
            localStorage.setItem('pcad_record', totalPuntos);
            localStorage.setItem('pcad_rango', rango);
        }
    }

    function reiniciarModuloActual() {
        sonido.click();
        if (appState.modo === 'dificil' || appState.modo === 'experto') {
            iniciarJuegoTeorico(appState.modo);
        } else if (appState.modo === 'estructuras') {
            iniciarJuegoEstructuras();
        } else if (appState.modo === 'despacho') {
            iniciarDespachoEDAN();
        } else {
            volverAlMenu();
        }
    }

    // --- ACCESIBILIDAD POR TECLADO ---
    window.addEventListener('keydown', (e) => {
        if (e.target && e.target.id === 'chat-input') return;

        const key = e.key.toUpperCase();
        const opciones = document.querySelectorAll('.screen.active .opcion:not(.bloqueada)');

        if (['1', '2', '3', '4', 'A', 'B', 'C', 'D'].includes(key)) {
            const indexMap = { '1': 0, 'A': 0, '2': 1, 'B': 1, '3': 2, 'C': 2, '4': 3, 'D': 3 };
            const targetIdx = indexMap[key];
            if (opciones[targetIdx]) {
                opciones[targetIdx].click();
            }
        } else if (e.key === 'Enter' || e.key === ' ') {
            const btnSiguiente = document.querySelector('.screen.active .btn-primary:not(:disabled)');
            if (btnSiguiente) {
                e.preventDefault();
                btnSiguiente.click();
            }
        } else if (e.key === 'Escape') {
            cerrarManual();
            const chat = document.getElementById('chat-container');
            if (chat) chat.style.display = 'none';
        }
    });
</script>
</body>
</html>
