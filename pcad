<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PCAD Operaciones - Simulador Táctico UNES</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --azul-pcad: #071325;
            --azul-superficie: #0d1f38;
            --azul-tarjeta: #132a4d;
            --azul-borde: #1e3f6f;
            --naranja-pcad: #FF6B00;
            --naranja-hover: #FF8533;
            --naranja-brillo: rgba(255, 107, 0, 0.35);
            --blanco: #F0F6FC;
            --texto-suave: #9BB0C7;
            --verde: #00E676;
            --verde-suave: rgba(0, 230, 118, 0.15);
            --rojo: #FF2E55;
            --rojo-suave: rgba(255, 46, 85, 0.15);
            --amarillo: #FFC400;
            --fuente-mono: 'JetBrains Mono', monospace;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Montserrat', sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background-color: var(--azul-pcad);
            color: var(--blanco);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background-image: 
                radial-gradient(circle at 50% 10%, rgba(255, 107, 0, 0.08) 0%, transparent 60%),
                radial-gradient(circle at 10% 90%, rgba(13, 31, 56, 0.8) 0%, transparent 50%),
                linear-gradient(180deg, #050d1a 0%, #071325 100%);
            padding: 10px;
            overflow-x: hidden;
        }

        #app {
            width: 100%;
            max-width: 1060px;
            min-height: 92vh;
            max-height: 96vh;
            background: rgba(13, 31, 56, 0.88);
            backdrop-filter: blur(14px);
            border: 2px solid var(--azul-borde);
            border-radius: 20px;
            display: flex;
            flex-direction: column;
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.65), 0 0 30px rgba(255, 107, 0, 0.12);
            position: relative;
            overflow: hidden;
        }

        /* HEADER TÁCTICO */
        header {
            background: linear-gradient(90deg, #09172c 0%, #0e2343 50%, #09172c 100%);
            padding: 12px 24px;
            border-bottom: 3px solid var(--naranja-pcad);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
            z-index: 10;
        }

        .logo-area {
            display: flex;
            align-items: center;
            gap: 14px;
            cursor: pointer;
        }

        .badge-pcad {
            width: 44px;
            height: 44px;
            flex-shrink: 0;
            filter: drop-shadow(0 2px 8px rgba(255, 107, 0, 0.4));
            transition: transform 0.3s;
        }
        .logo-area:hover .badge-pcad {
            transform: rotate(5deg) scale(1.05);
        }

        .header-titulos h1 {
            font-size: 1.15rem;
            font-weight: 800;
            letter-spacing: 1px;
            text-transform: uppercase;
            line-height: 1.1;
        }
        .header-titulos h1 span {
            color: var(--naranja-pcad);
        }
        .header-sub {
            font-size: 0.72rem;
            font-weight: 600;
            color: var(--texto-suave);
            letter-spacing: 0.5px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .status-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--verde);
            box-shadow: 0 0 8px var(--verde);
            display: inline-block;
            animation: pulseDot 2s infinite;
        }
        @keyframes pulseDot {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.4; transform: scale(0.85); }
        }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .btn-icon {
            background: var(--azul-tarjeta);
            border: 1px solid var(--azul-borde);
            color: var(--blanco);
            width: 38px;
            height: 38px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: 1.1rem;
            transition: all 0.2s;
        }
        .btn-icon:hover {
            border-color: var(--naranja-pcad);
            color: var(--naranja-pcad);
            transform: translateY(-2px);
        }

        /* PANTALLAS */
        .screen {
            display: none;
            flex: 1;
            padding: 24px 30px;
            flex-direction: column;
            overflow-y: auto;
            animation: fadeIn 0.35s ease-out;
        }
        .screen.active {
            display: flex;
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(12px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* MENÚ PRINCIPAL */
        .banner-intro {
            background: linear-gradient(135deg, rgba(255, 107, 0, 0.12) 0%, rgba(13, 31, 56, 0.6) 100%);
            border: 1px solid rgba(255, 107, 0, 0.25);
            border-radius: 14px;
            padding: 16px 20px;
            margin-bottom: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
        }
        .banner-intro h2 {
            font-size: 1.35rem;
            font-weight: 800;
            color: var(--blanco);
        }
        .banner-intro p {
            color: var(--texto-suave);
            font-size: 0.85rem;
            margin-top: 2px;
        }
        .stats-badge-group {
            display: flex;
            gap: 10px;
        }
        .stat-pill {
            background: var(--azul-pcad);
            border: 1px solid var(--azul-borde);
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 0.78rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .stat-pill span {
            color: var(--naranja-pcad);
            font-family: var(--fuente-mono);
        }

        .menu-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 18px;
            flex: 1;
        }

        .menu-card {
            background: var(--azul-tarjeta);
            border: 1px solid var(--azul-borde);
            border-radius: 16px;
            padding: 24px 20px;
            cursor: pointer;
            transition: all 0.28s cubic-bezier(0.16, 1, 0.3, 1);
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            position: relative;
            overflow: hidden;
        }
        .menu-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: linear-gradient(90deg, transparent, var(--naranja-pcad), transparent);
            opacity: 0;
            transition: opacity 0.3s;
        }
        .menu-card:hover {
            border-color: var(--naranja-pcad);
            transform: translateY(-5px);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4), 0 0 15px rgba(255, 107, 0, 0.2);
            background: #173259;
        }
        .menu-card:hover::before {
            opacity: 1;
        }
        .menu-icon-wrap {
            width: 52px;
            height: 52px;
            border-radius: 12px;
            background: rgba(255, 107, 0, 0.12);
            border: 1px solid rgba(255, 107, 0, 0.3);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
            margin-bottom: 16px;
            transition: transform 0.3s;
        }
        .menu-card:hover .menu-icon-wrap {
            transform: scale(1.1);
            background: rgba(255, 107, 0, 0.22);
        }
        .menu-tag {
            font-size: 0.65rem;
            text-transform: uppercase;
            font-weight: 800;
            letter-spacing: 1px;
            color: var(--naranja-pcad);
            margin-bottom: 4px;
        }
        .menu-title {
            font-size: 1.15rem;
            font-weight: 800;
            color: var(--blanco);
            margin-bottom: 8px;
        }
        .menu-desc {
            font-size: 0.82rem;
            color: var(--texto-suave);
            line-height: 1.45;
            margin-bottom: 16px;
            flex: 1;
        }
        .menu-footer {
            width: 100%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 0.75rem;
            color: var(--texto-suave);
            font-weight: 700;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
            padding-top: 10px;
        }
        .menu-footer span.arrow {
            color: var(--naranja-pcad);
            font-size: 1rem;
            transition: transform 0.2s;
        }
        .menu-card:hover .menu-footer span.arrow {
            transform: translateX(4px);
        }

        /* HUD GENERAL */
        .hud {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
            margin-bottom: 16px;
            font-weight: 700;
            font-size: 0.85rem;
        }
        .hud-group {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }
        .hud-item {
            background: var(--azul-tarjeta);
            padding: 8px 14px;
            border-radius: 12px;
            border: 1px solid var(--azul-borde);
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .hud-item span {
            color: var(--naranja-pcad);
            font-family: var(--fuente-mono);
            font-weight: 700;
        }
        .racha-badge {
            background: linear-gradient(135deg, rgba(255, 107, 0, 0.25), rgba(255, 46, 85, 0.2));
            border: 1px solid var(--naranja-pcad);
            color: var(--blanco);
            padding: 7px 12px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 0.8rem;
            font-weight: 800;
            animation: pulseRacha 1.5s infinite;
        }
        @keyframes pulseRacha {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.03); }
        }

        /* TIMER BAR */
        .timer-container {
            width: 100%;
            height: 6px;
            background: rgba(255, 255, 255, 0.08);
            border-radius: 3px;
            margin-bottom: 18px;
            overflow: hidden;
            display: none;
        }
        .timer-bar {
            height: 100%;
            width: 100%;
            background: var(--verde);
            transition: width 0.1s linear, background-color 0.3s;
        }

        /* PREGUNTA CONTAINER */
        .pregunta-container {
            background: var(--azul-tarjeta);
            padding: 22px 24px;
            border-radius: 16px;
            border-left: 5px solid var(--naranja-pcad);
            border-top: 1px solid var(--azul-borde);
            border-right: 1px solid var(--azul-borde);
            border-bottom: 1px solid var(--azul-borde);
            margin-bottom: 18px;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
        }
        .pregunta-categoria {
            display: inline-block;
            font-size: 0.72rem;
            text-transform: uppercase;
            font-weight: 800;
            color: var(--naranja-pcad);
            letter-spacing: 1px;
            margin-bottom: 8px;
        }
        .pregunta-texto {
            font-size: 1.15rem;
            font-weight: 700;
            line-height: 1.45;
            color: var(--blanco);
        }

        /* OPCIONES */
        .opciones-grid {
            display: flex;
            flex-direction: column;
            gap: 11px;
            margin-bottom: 18px;
        }
        .opcion {
            background: var(--azul-superficie);
            border: 2px solid var(--azul-borde);
            color: var(--blanco);
            padding: 14px 18px;
            border-radius: 12px;
            cursor: pointer;
            font-size: 0.95rem;
            font-weight: 600;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            gap: 14px;
            text-align: left;
        }
        .opcion:hover:not(.bloqueada) {
            border-color: var(--naranja-pcad);
            background: #142847;
            transform: translateX(6px);
        }
        .opcion .letra {
            background: var(--azul-tarjeta);
            min-width: 34px;
            height: 34px;
            display: flex;
            justify-content: center;
            align-items: center;
            border-radius: 8px;
            font-weight: 900;
            color: var(--naranja-pcad);
            border: 1px solid var(--azul-borde);
            font-family: var(--fuente-mono);
            font-size: 0.85rem;
            flex-shrink: 0;
            transition: all 0.2s;
        }
        .opcion.correcta {
            background: var(--verde-suave);
            border-color: var(--verde);
            color: var(--blanco);
            transform: scale(1.01);
        }
        .opcion.correcta .letra {
            background: var(--verde);
            color: var(--azul-pcad);
            border: none;
        }
        .opcion.incorrecta {
            background: var(--rojo-suave);
            border-color: var(--rojo);
            color: var(--texto-suave);
            opacity: 0.85;
        }
        .opcion.incorrecta .letra {
            background: var(--rojo);
            color: var(--blanco);
            border: none;
        }
        .opcion.bloqueada {
            cursor: default;
        }

        /* FEEDBACK BOX */
        .feedback-box {
            padding: 16px 20px;
            border-radius: 12px;
            display: none;
            animation: fadeIn 0.3s;
            margin-bottom: 18px;
            font-size: 0.92rem;
            line-height: 1.45;
        }
        .feedback-box.show {
            display: block;
        }
        .feedback-box.ok {
            background: var(--verde-suave);
            border: 1px solid var(--verde);
            color: #d1fae5;
        }
        .feedback-box.fail {
            background: var(--rojo-suave);
            border: 1px solid var(--rojo);
            color: #ffe4e6;
        }
        .feedback-box .justificacion {
            margin-top: 6px;
            font-size: 0.84rem;
            opacity: 0.9;
        }

        /* BOTONES DE ACCIÓN */
        .action-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            margin-top: auto;
            padding-top: 10px;
        }
        .btn-secondary {
            background: transparent;
            color: var(--texto-suave);
            border: 1px solid var(--azul-borde);
            padding: 12px 20px;
            font-size: 0.85rem;
            font-weight: 700;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .btn-secondary:hover {
            color: var(--blanco);
            border-color: var(--texto-suave);
            background: rgba(255, 255, 255, 0.05);
        }

        .btn-primary {
            background: var(--naranja-pcad);
            color: #071325;
            border: none;
            padding: 13px 28px;
            font-size: 0.92rem;
            font-weight: 900;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.25s;
            text-transform: uppercase;
            letter-spacing: 1px;
            display: flex;
            align-items: center;
            gap: 8px;
            box-shadow: 0 4px 15px rgba(255, 107, 0, 0.35);
        }
        .btn-primary:hover:not(:disabled) {
            background: var(--naranja-hover);
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(255, 107, 0, 0.45);
        }
        .btn-primary:disabled {
            background: #2b3b52;
            color: #64748b;
            cursor: not-allowed;
            box-shadow: none;
            transform: none;
        }

        /* MINIJUEGO ESTRUCTURAS MEJORADO */
        .estructura-escena {
            background: radial-gradient(circle at center, #11284a 0%, #0a1b33 100%);
            border: 1px solid var(--azul-borde);
            border-radius: 16px;
            padding: 24px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            position: relative;
            margin-bottom: 16px;
            min-height: 280px;
        }
        .svg-canvas-wrap {
            width: 100%;
            max-width: 380px;
            height: 210px;
            display: flex;
            justify-content: center;
            align-items: center;
            margin-bottom: 14px;
            filter: drop-shadow(0 8px 18px rgba(0, 0, 0, 0.45));
        }
        .svg-canvas-wrap svg {
            width: 100%;
            height: 100%;
        }

        .est-titulo-wrap {
            text-align: center;
            max-width: 680px;
        }
        .est-titulo {
            color: var(--naranja-pcad);
            font-size: 1.25rem;
            font-weight: 800;
            margin-bottom: 6px;
        }
        .est-desc {
            color: var(--blanco);
            font-size: 0.95rem;
            line-height: 1.45;
        }

        .botones-decision {
            display: flex;
            gap: 16px;
            justify-content: center;
            width: 100%;
            margin-top: 12px;
        }
        .btn-decision {
            padding: 14px 34px;
            font-size: 1rem;
            font-weight: 800;
            border: none;
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.25s;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            display: flex;
            align-items: center;
            gap: 8px;
            flex: 1;
            max-width: 260px;
            justify-content: center;
        }
        .btn-seguro {
            background: var(--verde);
            color: #071325;
            box-shadow: 0 4px 15px rgba(0, 230, 118, 0.3);
        }
        .btn-seguro:hover {
            background: #26ff8c;
            transform: translateY(-3px);
            box-shadow: 0 8px 22px rgba(0, 230, 118, 0.45);
        }
        .btn-peligro {
            background: var(--rojo);
            color: var(--blanco);
            box-shadow: 0 4px 15px rgba(255, 46, 85, 0.35);
        }
        .btn-peligro:hover {
            background: #ff476b;
            transform: translateY(-3px);
            box-shadow: 0 8px 22px rgba(255, 46, 85, 0.5);
        }

        /* PANTALLA SALA SITUACIONAL (DESPACHO EDAN) */
        .despacho-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 18px;
            margin-bottom: 18px;
        }
        .despacho-card {
            background: var(--azul-superficie);
            border: 1px solid var(--azul-borde);
            border-radius: 14px;
            padding: 16px;
        }
        .despacho-card h4 {
            color: var(--naranja-pcad);
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .radio-transcript {
            background: #050d1a;
            border: 1px solid #193154;
            border-radius: 10px;
            padding: 14px;
            font-family: var(--fuente-mono);
            font-size: 0.84rem;
            color: #4ade80;
            line-height: 1.5;
            position: relative;
        }
        .radio-transcript::before {
            content: "🔴 RX FREC: 156.800 MHz (VHF Ch 16)";
            display: block;
            color: var(--texto-suave);
            font-size: 0.7rem;
            margin-bottom: 8px;
            font-weight: 700;
        }

        /* PANTALLA RESULTADOS FINAL */
        .resultado-box {
            background: var(--azul-tarjeta);
            border: 2px solid var(--azul-borde);
            border-radius: 20px;
            padding: 30px;
            text-align: center;
            max-width: 650px;
            margin: auto;
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.4);
        }
        .rango-emblema {
            width: 90px;
            height: 90px;
            margin: 0 auto 16px;
            border-radius: 50%;
            background: radial-gradient(circle, var(--naranja-hover), var(--naranja-pcad));
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            box-shadow: 0 0 25px rgba(255, 107, 0, 0.5);
        }
        .nota-grande {
            font-size: 3.5rem;
            font-weight: 900;
            color: var(--blanco);
            line-height: 1;
            margin-bottom: 6px;
            font-family: var(--fuente-mono);
        }
        .nota-grande span {
            font-size: 1.5rem;
            color: var(--naranja-pcad);
        }
        .calificacion-unes {
            font-size: 1.15rem;
            font-weight: 800;
            margin-bottom: 18px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .resultado-stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
            margin: 20px 0;
            background: var(--azul-superficie);
            padding: 14px;
            border-radius: 12px;
            border: 1px solid var(--azul-borde);
        }
        .res-stat-val {
            font-family: var(--fuente-mono);
            font-size: 1.4rem;
            font-weight: 700;
            color: var(--naranja-pcad);
        }
        .res-stat-lbl {
            font-size: 0.72rem;
            color: var(--texto-suave);
            text-transform: uppercase;
            font-weight: 700;
            margin-top: 4px;
        }

        /* MODAL MANUAL / GLOSARIO */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(4, 11, 22, 0.85);
            backdrop-filter: blur(8px);
            z-index: 150;
            display: none;
            justify-content: center;
            align-items: center;
            padding: 16px;
        }
        .modal-overlay.active {
            display: flex;
        }
        .modal-content {
            background: var(--azul-tarjeta);
            border: 2px solid var(--naranja-pcad);
            border-radius: 18px;
            width: 100%;
            max-width: 680px;
            max-height: 85vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.7);
        }
        .modal-header {
            background: #09172c;
            padding: 16px 22px;
            border-bottom: 1px solid var(--azul-borde);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .modal-header h3 {
            color: var(--naranja-pcad);
            font-size: 1.1rem;
            font-weight: 800;
            display: flex;
